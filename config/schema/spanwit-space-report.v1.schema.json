{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/spanwit/space-report/v1.json",
  "title": "Spanwit Space Report v1",
  "description": "Read-only disk diagnostic report from spanwit space --format json. Never includes an execute/delete path. Section boundaries enforce trust-state placement for future API consumers.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "generated_at",
    "root",
    "min_size",
    "include_home_caches",
    "top",
    "max_depth",
    "sort_mode",
    "reclaim_scope",
    "pressure",
    "verified_reclaimable",
    "hotspots",
    "unverified",
    "unknown"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://schemas.3leaps.dev/spanwit/space-report/v1.json"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "min_size": {
      "type": "string",
      "minLength": 1,
      "description": "Opt-in size floor display; \"none\" when unset."
    },
    "include_home_caches": {
      "type": "boolean"
    },
    "top": {
      "type": "integer",
      "minimum": 1
    },
    "max_depth": {
      "type": "integer",
      "description": "Bound on name-shaped unverified and verified discovery depth under root."
    },
    "sort_mode": {
      "type": "string",
      "enum": [
        "idle",
        "size"
      ],
      "description": "Ranking policy for verified candidates (advisory only)."
    },
    "reclaim_scope": {
      "type": "string",
      "enum": [
        "whole",
        "incremental"
      ],
      "description": "Plan-wide reclaim granularity; carried into exact_plan for replay."
    },
    "mutation_contract": {
      "type": "string",
      "enum": [
        "open",
        "read_only"
      ],
      "description": "Effective invocation mutation contract (read_only when no-mutation assertion is active)."
    },
    "completion": {
      "$ref": "#/$defs/completion"
    },
    "temp_plane_coverage": {
      "$ref": "#/$defs/temp_plane_coverage"
    },
    "pressure": {
      "$ref": "#/$defs/pressure",
      "description": "Primary write/home volume capacity (not necessarily the analysis root mount)."
    },
    "analysis_pressure": {
      "$ref": "#/$defs/pressure",
      "description": "Present when the analysis root is on a different volume than pressure."
    },
    "verified_reclaimable": {
      "type": "object",
      "required": [
        "candidates",
        "prunable_candidates",
        "prunable_bytes",
        "prunable_human",
        "withheld_candidates",
        "withheld_bytes",
        "withheld_human",
        "size_incomplete"
      ],
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verified_entry"
          }
        },
        "prunable_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "prunable_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "prunable_human": {
          "type": "string"
        },
        "withheld_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "withheld_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "withheld_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean",
          "description": "True when any candidate size is a depth-bounded partial measurement; byte totals are lower bounds only."
        }
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotspot_entry"
      }
    },
    "unverified": {
      "type": "object",
      "required": [
        "count",
        "total_bytes",
        "total_human",
        "entries",
        "size_incomplete"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_human": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unverified_entry"
          }
        },
        "size_incomplete": {
          "type": "boolean",
          "description": "True when any full-set unverified entry was depth-bounded; total_bytes is a lower bound even if incomplete rows are top-truncated out of entries."
        }
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown_entry"
      }
    },
    "prune_handoff": {
      "$ref": "#/$defs/prune_handoff",
      "description": "Optional prune handoff: prunable-only rows from this report (the dry-run for those paths) plus allowlist revalidate commands. Never includes diagnostic-only mass."
    },
    "recipes": {
      "type": "array",
      "description": "Optional guided recipes for diagnostic-only cleanup. Suggested external commands only; never executable by spanwit.",
      "items": {
        "$ref": "#/$defs/recipe"
      }
    },
    "applied_filters": {
      "$ref": "#/$defs/applied_filters",
      "description": "Present when opt-in --class/--domain projection was applied. Distinguishes honestly empty filtered views from unfiltered empty inventory."
    },
    "enabled_domains": {
      "type": "array",
      "description": "Resolved domains.enabled policy set (authorize-narrow): which use domains may drive recipes and reclaim. Present only when the config supplied a domains block; absent means the built-in default. This is policy, not the --domain view projection.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9_-]*[a-z0-9])?$"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "applied_filters": {
      "type": "object",
      "required": [
        "classes",
        "domains"
      ],
      "additionalProperties": false,
      "description": "Canonical inventory projection. Both arrays are always present (possibly empty) when the object is set.",
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "prunable",
              "withheld",
              "diagnostic-only",
              "unverified",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9_-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9_-]*[a-z0-9])?)*$"
          },
          "uniqueItems": true
        }
      }
    },
    "pressure": {
      "type": "object",
      "required": [
        "path",
        "total_bytes",
        "total_human",
        "used_bytes",
        "used_human",
        "avail_bytes",
        "avail_human",
        "used_percent",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "mount": {
          "type": "string"
        },
        "volume_id": {
          "type": "string",
          "description": "Opaque filesystem identity for same-volume comparison across platforms."
        },
        "role": {
          "type": "string",
          "enum": [
            "primary_write",
            "analysis_root"
          ]
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_human": {
          "type": "string"
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_human": {
          "type": "string"
        },
        "avail_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "avail_human": {
          "type": "string"
        },
        "used_percent": {
          "type": "number",
          "minimum": 0
        },
        "level": {
          "type": "string",
          "enum": [
            "ok",
            "warn",
            "critical"
          ]
        }
      }
    },
    "verified_entry": {
      "type": "object",
      "required": [
        "path",
        "size_bytes",
        "size_human",
        "state",
        "reclaim_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "prunable",
            "withheld"
          ]
        },
        "withheld_reason": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rebuild_expectation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective_min_size": {
          "type": "string"
        },
        "effective_min_age": {
          "type": "string"
        },
        "effective_max_age": {
          "type": "string"
        },
        "last_activity_at": {
          "type": "string",
          "description": "Newest observed descendant file mtime (RFC3339). Advisory ranking only."
        },
        "activity_basis": {
          "type": "string",
          "enum": [
            "descendant_mtime",
            "unknown"
          ]
        },
        "activity_incomplete": {
          "type": "boolean"
        },
        "reclaim_scope": {
          "type": "string",
          "enum": [
            "whole",
            "incremental"
          ]
        },
        "parent_path": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "description": "Derived from signature taxonomy spine (domain segment)."
        },
        "ecosystem": {
          "type": "string",
          "description": "Derived from signature taxonomy spine (ecosystem segment)."
        },
        "catalog_id": {
          "type": "string",
          "description": "Optional full-spine id; verified rows normally use signature instead."
        },
        "recipe_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional stable linkage to guided recipes."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reclaim_scope": {
                "const": "incremental"
              }
            },
            "required": [
              "reclaim_scope"
            ]
          },
          "then": {
            "required": [
              "parent_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reclaim_scope": {
                "const": "whole"
              }
            },
            "required": [
              "reclaim_scope"
            ]
          },
          "then": {
            "not": {
              "required": [
                "parent_path"
              ]
            }
          }
        }
      ]
    },
    "hotspot_entry": {
      "type": "object",
      "required": [
        "path",
        "size_bytes",
        "size_human",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "const": "diagnostic-only"
        },
        "withheld_reason": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rebuild_expectation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domain": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string",
          "description": "Provisional full-spine catalog id for inventory filters."
        },
        "recipe_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unverified_entry": {
      "type": "object",
      "required": [
        "path",
        "size_bytes",
        "size_human",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "const": "unverified"
        },
        "withheld_reason": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rebuild_expectation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domain": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string"
        },
        "recipe_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unknown_entry": {
      "type": "object",
      "required": [
        "path",
        "size_bytes",
        "size_human",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "const": "unknown"
        },
        "withheld_reason": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rebuild_expectation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domain": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string"
        },
        "recipe_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prune_handoff": {
      "type": "object",
      "required": [
        "present",
        "analysis_root",
        "min_size",
        "prunable_count",
        "prunable_bytes",
        "prunable_human",
        "size_incomplete",
        "candidates",
        "suggested_commands",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "present": {
          "type": "boolean"
        },
        "analysis_root": {
          "type": "string"
        },
        "min_size": {
          "type": "string"
        },
        "prunable_count": {
          "type": "integer",
          "minimum": 0
        },
        "prunable_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "prunable_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/handoff_entry"
          }
        },
        "exact_plan": {
          "$ref": "#/$defs/exact_plan"
        },
        "suggested_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggested_command"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "handoff_entry": {
      "type": "object",
      "required": [
        "path",
        "size_bytes",
        "size_human",
        "state",
        "reclaim_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "const": "prunable"
        },
        "withheld_reason": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rebuild_expectation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective_min_size": {
          "type": "string"
        },
        "effective_min_age": {
          "type": "string"
        },
        "effective_max_age": {
          "type": "string"
        },
        "last_activity_at": {
          "type": "string"
        },
        "activity_basis": {
          "type": "string",
          "enum": [
            "descendant_mtime",
            "unknown"
          ]
        },
        "activity_incomplete": {
          "type": "boolean"
        },
        "reclaim_scope": {
          "type": "string",
          "enum": [
            "whole",
            "incremental"
          ]
        },
        "parent_path": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string"
        },
        "recipe_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reclaim_scope": {
                "const": "incremental"
              }
            },
            "required": [
              "reclaim_scope"
            ]
          },
          "then": {
            "required": [
              "parent_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reclaim_scope": {
                "const": "whole"
              }
            },
            "required": [
              "reclaim_scope"
            ]
          },
          "then": {
            "not": {
              "required": [
                "parent_path"
              ]
            }
          }
        }
      ]
    },
    "exact_plan": {
      "type": "object",
      "required": [
        "$schema",
        "version",
        "analysis_root",
        "min_size",
        "sort_mode",
        "reclaim_scope",
        "candidates"
      ],
      "additionalProperties": false,
      "description": "Policy-preserving exact-path plan for prune --from-space-report revalidation.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "const": 1
        },
        "analysis_root": {
          "type": "string"
        },
        "min_size": {
          "type": "string"
        },
        "sort_mode": {
          "type": "string",
          "enum": [
            "idle",
            "size"
          ]
        },
        "reclaim_scope": {
          "type": "string",
          "enum": [
            "whole",
            "incremental"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exact_candidate"
          }
        },
        "signatures": {
          "type": "object",
          "description": "Additive signature catalog (custom signatures only).",
          "additionalProperties": true
        }
      }
    },
    "exact_candidate": {
      "type": "object",
      "required": [
        "path",
        "effective_min_size",
        "effective_min_age",
        "effective_max_age",
        "size_bytes",
        "size_human",
        "reclaim_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "effective_min_size": {
          "type": "string"
        },
        "effective_min_age": {
          "type": "string"
        },
        "effective_max_age": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_human": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "reclaim_scope": {
          "type": "string",
          "enum": [
            "whole",
            "incremental"
          ]
        },
        "parent_path": {
          "type": "string",
          "minLength": 1
        },
        "last_activity_at": {
          "type": "string"
        },
        "activity_basis": {
          "type": "string",
          "enum": [
            "descendant_mtime",
            "unknown"
          ]
        },
        "activity_incomplete": {
          "type": "boolean"
        },
        "rebuild_expectation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reclaim_scope": {
                "const": "incremental"
              }
            },
            "required": [
              "reclaim_scope"
            ]
          },
          "then": {
            "required": [
              "parent_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reclaim_scope": {
                "const": "whole"
              }
            },
            "required": [
              "reclaim_scope"
            ]
          },
          "then": {
            "not": {
              "required": [
                "parent_path"
              ]
            }
          }
        }
      ]
    },
    "recipe": {
      "type": "object",
      "required": [
        "id",
        "title",
        "state",
        "suggested_commands"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "const": "diagnostic-only",
          "description": "Recipes are always diagnostic-only; never prunable."
        },
        "kind": {
          "type": "string",
          "enum": [
            "argv",
            "structural"
          ],
          "description": "argv (default when omitted) is a single-shot external-command suggestion; structural is a multi-step print-only journey (016A)."
        },
        "rebuild_expectation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "path": {
          "type": "string"
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggested_command"
          }
        },
        "steps": {
          "type": "array",
          "description": "Ordered steps for kind=structural recipes. Print-only; never auto-executed. Go load rejects argv recipes with steps and structural recipes without steps.",
          "items": {
            "$ref": "#/$defs/recipe_step"
          }
        },
        "exact_plan": {
          "$ref": "#/$defs/exact_plan",
          "description": "Optional closed-set revalidation plan scoped to this recipe (e.g. Cargo-only). Revalidate with prune --from-exact-plan; not the report-wide prune_handoff."
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domain": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string",
          "description": "Full-spine taxonomy id for domain filtering (e.g. development.rust.rustup)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "structural"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "steps"
            ],
            "properties": {
              "steps": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "argv"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "steps": {
                "maxItems": 0
              },
              "exact_plan": false
            }
          }
        }
      ]
    },
    "recipe_step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": false,
      "description": "One ordered step in a structural guided recipe. Print-only; spanwit never writes config or deletes.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "observe",
            "command",
            "config_snippet",
            "purge_hint",
            "verify"
          ]
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "$ref": "#/$defs/suggested_command"
        },
        "config_snippet": {
          "$ref": "#/$defs/config_snippet"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "config_snippet"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "config_snippet"
            ],
            "properties": {
              "command": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "purge_hint",
                  "verify"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ],
            "properties": {
              "config_snippet": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "observe"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "command": false,
              "config_snippet": false
            }
          }
        }
      ]
    },
    "config_snippet": {
      "type": "object",
      "required": [
        "label",
        "content"
      ],
      "additionalProperties": false,
      "description": "Copy-paste config fragment. Never written by spanwit.",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "suggested_command": {
      "type": "object",
      "required": [
        "program",
        "args",
        "display"
      ],
      "additionalProperties": false,
      "description": "Machine-safe argv form plus shell-safe display line. Never auto-executed by spanwit.",
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temp_plane_coverage": {
      "type": "object",
      "description": "OS temp roots this run did not walk, present only under warn/critical primary pressure. Observation only: carries no prune authority and never names children.",
      "required": [
        "trigger",
        "planes"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "warn",
            "critical"
          ]
        },
        "planes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/temp_plane"
          }
        }
      }
    },
    "temp_plane": {
      "type": "object",
      "required": [
        "root",
        "kind",
        "size_status",
        "size_basis",
        "follow_up"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical temp root (no children)."
        },
        "kind": {
          "type": "string",
          "enum": [
            "shared-temp",
            "user-temp"
          ]
        },
        "size_status": {
          "type": "string",
          "enum": [
            "measured",
            "partial",
            "unavailable"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact when measured; lower bound when partial; absent when unavailable."
        },
        "size_basis": {
          "type": "string",
          "enum": [
            "apparent"
          ]
        },
        "follow_up": {
          "type": "string",
          "minLength": 1,
          "description": "Root-level space command for the operator to run explicitly."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "size_status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "size_bytes"
              ]
            }
          },
          "else": {
            "required": [
              "size_bytes"
            ]
          }
        }
      ]
    },
    "completion": {
      "type": "object",
      "description": "Whether the requested observation finished without coverage warnings. Mirrors the CLI exit contract (complete=0, partial=1). Never deletion authority.",
      "required": [
        "lifecycle",
        "warning_count"
      ],
      "additionalProperties": false,
      "properties": {
        "lifecycle": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "warning_count": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "warning_count": {
                "minimum": 1
              }
            }
          }
        }
      ]
    }
  }
}
