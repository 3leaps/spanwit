{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/spanwit/prune-plan/v1.json",
  "title": "Spanwit Prune Plan Output v1",
  "description": "Schema for structured JSON output emitted by spanwit prune --format json.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "config_path",
    "mode",
    "generated_at",
    "sort_mode",
    "reclaim_scope",
    "effective_filters",
    "summary",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://schemas.3leaps.dev/spanwit/prune-plan/v1.json"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "config_path": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "dry-run",
        "execute"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sort_mode": {
      "type": "string",
      "enum": [
        "size",
        "idle"
      ],
      "description": "Ranking policy applied to candidates (advisory)."
    },
    "reclaim_scope": {
      "type": "string",
      "enum": [
        "whole",
        "incremental"
      ],
      "description": "Plan-wide reclaim granularity."
    },
    "effective_filters": {
      "type": "object",
      "description": "Plan-level aggregate of resolved filters over discovered candidates (defaults \u2192 path \u2192 target). min_age=older-than floor; max_age=younger-than ceiling. Single value when every candidate agrees; \"mixed\" when resolutions differ; falls back to global defaults when there are no candidates.",
      "required": [
        "min_size",
        "min_age",
        "max_age"
      ],
      "additionalProperties": false,
      "properties": {
        "min_size": {
          "type": "string",
          "minLength": 1,
          "description": "Aggregate min_size: a concrete value, \"none\", or \"mixed\"."
        },
        "min_age": {
          "type": "string",
          "minLength": 1,
          "description": "Aggregate min_age (older-than floor): a concrete value, \"none\", or \"mixed\"."
        },
        "max_age": {
          "type": "string",
          "minLength": 1,
          "description": "Aggregate max_age (younger-than ceiling): a concrete value, \"none\", or \"mixed\"."
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "candidates/total_* count every discovered match (prunable + withheld). prunable_* is the reclaimable amount; withheld_* is reported but excluded from --execute.",
      "required": [
        "candidates",
        "total_bytes",
        "total_human",
        "prunable_candidates",
        "prunable_bytes",
        "prunable_human",
        "withheld_candidates",
        "withheld_bytes",
        "withheld_human",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_human": {
          "type": "string",
          "minLength": 1
        },
        "prunable_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "prunable_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "prunable_human": {
          "type": "string",
          "minLength": 1
        },
        "withheld_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "withheld_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "withheld_human": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "deleted_candidates",
        "deleted_bytes",
        "deleted_human"
      ],
      "additionalProperties": false,
      "properties": {
        "deleted_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "deleted_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "deleted_human": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "size_human",
          "state",
          "effective_min_size",
          "effective_min_age",
          "effective_max_age",
          "confidence",
          "reclaim_scope"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "size_human": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "prunable",
              "withheld"
            ]
          },
          "withheld_reason": {
            "type": "string",
            "enum": [
              "safe_to_prune",
              "age",
              "min_size",
              "indeterminate",
              "domain_disabled"
            ],
            "description": "Why the match is withheld. age = failed age window (min_age floor and/or max_age ceiling); min_size = complete measurement below size floor; indeterminate = depth-bounded lower bound below size floor so the threshold cannot be decided; safe_to_prune = signature not marked safe; domain_disabled = use domain not in an explicitly configured domains.enabled set."
          },
          "effective_min_size": {
            "type": "string",
            "minLength": 1,
            "description": "Resolved min_size for this candidate (defaults \u2192 path \u2192 target), or \"none\" when unset."
          },
          "effective_min_age": {
            "type": "string",
            "minLength": 1,
            "description": "Resolved min_age (older-than floor) for this candidate (defaults \u2192 path \u2192 target), or \"none\" when unset."
          },
          "effective_max_age": {
            "type": "string",
            "minLength": 1,
            "description": "Resolved max_age (younger-than ceiling) for this candidate (defaults \u2192 path \u2192 target), or \"none\" when unset."
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "pattern",
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deleted": {
            "type": "boolean"
          },
          "last_activity_at": {
            "type": "string",
            "description": "Newest observed descendant file mtime (RFC3339). Advisory only."
          },
          "activity_basis": {
            "type": "string",
            "enum": [
              "descendant_mtime",
              "unknown"
            ]
          },
          "activity_incomplete": {
            "type": "boolean"
          },
          "rebuild_expectation": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "Advisory refill likelihood from complete activity; omitted when unknown."
          },
          "reclaim_scope": {
            "type": "string",
            "enum": [
              "whole",
              "incremental"
            ]
          },
          "parent_path": {
            "type": "string",
            "minLength": 1,
            "description": "Verified cargo-target parent when reclaim_scope is incremental."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reclaim_scope": {
                  "const": "incremental"
                }
              },
              "required": [
                "reclaim_scope"
              ]
            },
            "then": {
              "required": [
                "parent_path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "reclaim_scope": {
                  "const": "whole"
                }
              },
              "required": [
                "reclaim_scope"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "parent_path"
                ]
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
