{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/spanwit/daemon-response/v1.json",
  "title": "Experimental observation daemon response",
  "oneOf": [
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/proposals"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "volume_id",
        "basis",
        "avail_bytes",
        "total_bytes",
        "used_bytes",
        "used_percent",
        "level",
        "coverage",
        "seq",
        "size_complete"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "volume_id": {
          "type": "string",
          "minLength": 1
        },
        "mount_path": {
          "type": "string"
        },
        "basis": {
          "const": "statfs_primary"
        },
        "avail_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": [
            "ok",
            "warn",
            "critical"
          ]
        },
        "coverage": {
          "const": "complete"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "const": "capacity.SampleFilesystem"
        },
        "size_complete": {
          "const": true
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "state": {
          "enum": [
            "awaiting_sample",
            "observing",
            "sample_unavailable",
            "journal_unavailable"
          ]
        },
        "sample": {
          "$ref": "#/$defs/sample"
        },
        "record_id": {
          "type": "string",
          "format": "uuid"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "attribution_state": {
          "enum": [
            "awaiting_attribution",
            "complete",
            "partial",
            "unavailable"
          ]
        }
      },
      "dependentRequired": {
        "sample": [
          "record_id"
        ],
        "record_id": [
          "sample"
        ],
        "attribution": [
          "attribution_state"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observing"
              }
            }
          },
          "then": {
            "required": [
              "sample",
              "record_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "awaiting_sample"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sample"
                  ]
                },
                {
                  "required": [
                    "record_id"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "attribution_state"
            ],
            "properties": {
              "attribution_state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "required": [
              "attribution"
            ],
            "properties": {
              "attribution": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "attribution_state"
            ],
            "properties": {
              "attribution_state": {
                "const": "partial"
              }
            }
          },
          "then": {
            "required": [
              "attribution"
            ],
            "properties": {
              "attribution": {
                "properties": {
                  "complete": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "attribution_state"
            ],
            "properties": {
              "attribution_state": {
                "const": "awaiting_attribution"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "attribution"
              ]
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operations",
        "sample_schema",
        "journal_contract",
        "proposal_evaluation",
        "mutation"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "operations": {
          "const": [
            "capabilities",
            "status",
            "proposals.read"
          ]
        },
        "sample_schema": {
          "const": "https://schemas.3leaps.dev/spanwit/growth-sample/v0.json"
        },
        "journal_contract": {
          "const": "durable-record/v1"
        },
        "proposal_evaluation": {
          "const": false
        },
        "mutation": {
          "const": false
        }
      }
    },
    "proposals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state",
        "items",
        "next_cursor"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "state": {
          "const": "not_evaluated"
        },
        "items": {
          "type": "array",
          "maxItems": 0
        },
        "next_cursor": {
          "type": "null"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "error"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "error": {
          "enum": [
            "method_not_allowed",
            "invalid_request",
            "unsupported_operation"
          ]
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "record_id",
        "capacity_record_id",
        "captured_at",
        "complete",
        "reasons",
        "rows"
      ],
      "properties": {
        "$schema": {
          "const": "https://schemas.3leaps.dev/spanwit/root-attribution/v0.json"
        },
        "version": {
          "const": 0
        },
        "record_id": {
          "type": "string",
          "format": "uuid"
        },
        "capacity_record_id": {
          "type": "string",
          "format": "uuid"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "initial_baseline",
              "free_space_loss_since_baseline",
              "free_space_loss_since_heartbeat",
              "hourly_baseline",
              "pressure_worsened"
            ]
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation"
            ],
            "properties": {
              "observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "basis",
                  "coverage",
                  "activity",
                  "captured_at",
                  "files",
                  "gaps"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "device_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "const": "path_entry_allocated_blocks_sum"
                  },
                  "coverage": {
                    "enum": [
                      "complete",
                      "partial",
                      "unavailable",
                      "incomparable",
                      "deferred"
                    ]
                  },
                  "activity": {
                    "enum": [
                      "active",
                      "unknown"
                    ]
                  },
                  "captured_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "allocated_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "files": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gaps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "identity": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "coverage": {
                          "const": "complete"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "device_id",
                        "file_id",
                        "allocated_bytes",
                        "identity"
                      ],
                      "properties": {
                        "gaps": {
                          "const": 0
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "required": [
                          "allocated_bytes"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "coverage": {
                          "const": "deferred"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "activity": {
                          "const": "active"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "activity": {
                          "const": "unknown"
                        }
                      }
                    }
                  }
                ]
              },
              "delta_bytes": {
                "type": "integer"
              },
              "baseline_record_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "dependentRequired": {
              "delta_bytes": [
                "baseline_record_id"
              ],
              "baseline_record_id": [
                "delta_bytes"
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "delta_bytes"
                  ]
                },
                "then": {
                  "properties": {
                    "observation": {
                      "properties": {
                        "coverage": {
                          "const": "complete"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "observation": {
                      "properties": {
                        "coverage": {
                          "const": "complete"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "rows": {
                "contains": {
                  "properties": {
                    "observation": {
                      "properties": {
                        "coverage": {
                          "not": {
                            "const": "complete"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
