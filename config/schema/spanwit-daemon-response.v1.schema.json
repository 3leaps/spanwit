{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/spanwit/daemon-response/v1.json",
  "title": "Experimental observation daemon response",
  "oneOf": [
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/proposals"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "volume_id",
        "basis",
        "avail_bytes",
        "total_bytes",
        "used_bytes",
        "used_percent",
        "level",
        "coverage",
        "seq",
        "size_complete"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "volume_id": {
          "type": "string",
          "minLength": 1
        },
        "mount_path": {
          "type": "string"
        },
        "basis": {
          "const": "statfs_primary"
        },
        "avail_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": [
            "ok",
            "warn",
            "critical"
          ]
        },
        "coverage": {
          "const": "complete"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "const": "capacity.SampleFilesystem"
        },
        "size_complete": {
          "const": true
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "pid",
        "started_at",
        "config_sha256"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "executable_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "dependentRequired": {
        "executable_path": [
          "executable_sha256"
        ],
        "executable_sha256": [
          "executable_path"
        ]
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "state": {
          "enum": [
            "awaiting_sample",
            "observing",
            "sample_unavailable",
            "journal_unavailable",
            "journal_capacity_reached"
          ]
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "sample": {
          "$ref": "#/$defs/sample"
        },
        "record_id": {
          "type": "string",
          "format": "uuid"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "attribution_state": {
          "enum": [
            "awaiting_attribution",
            "complete",
            "partial",
            "unavailable"
          ]
        }
      },
      "dependentRequired": {
        "sample": [
          "record_id"
        ],
        "record_id": [
          "sample"
        ],
        "attribution": [
          "attribution_state"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observing"
              }
            }
          },
          "then": {
            "required": [
              "sample",
              "record_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "awaiting_sample"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sample"
                  ]
                },
                {
                  "required": [
                    "record_id"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "attribution_state"
            ],
            "properties": {
              "attribution_state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "required": [
              "attribution"
            ],
            "properties": {
              "attribution": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "attribution_state"
            ],
            "properties": {
              "attribution_state": {
                "const": "partial"
              }
            }
          },
          "then": {
            "required": [
              "attribution"
            ],
            "properties": {
              "attribution": {
                "properties": {
                  "complete": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "attribution_state"
            ],
            "properties": {
              "attribution_state": {
                "const": "awaiting_attribution"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "attribution"
              ]
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operations",
        "sample_schema",
        "journal_contract",
        "proposal_evaluation",
        "mutation"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "operations": {
          "const": [
            "capabilities",
            "status",
            "proposals.read"
          ]
        },
        "sample_schema": {
          "const": "https://schemas.3leaps.dev/spanwit/growth-sample/v0.json"
        },
        "journal_contract": {
          "const": "durable-record/v1"
        },
        "proposal_evaluation": {
          "type": "boolean"
        },
        "mutation": {
          "const": false
        }
      }
    },
    "proposals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state",
        "items",
        "next_cursor"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "state": {
          "enum": [
            "not_evaluated",
            "evaluated",
            "partial",
            "unavailable"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "pack_revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "compiled_policy_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "capacity_record_id": {
          "type": "string",
          "format": "uuid"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_authorized": {
          "const": false
        },
        "volume_objective": {
          "$ref": "#/$defs/volume_objective_eval"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal_item"
          }
        },
        "next_cursor": {
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not_evaluated",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "evaluated",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "required": [
              "profile",
              "pack_revision",
              "compiled_policy_digest",
              "evaluated_at"
            ]
          }
        }
      ]
    },
    "proposal_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "state",
        "roots",
        "proposed_items_count",
        "proposed_reclaim_bytes",
        "candidates",
        "warnings"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_items_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "proposed_items_count": {
          "type": "integer",
          "minimum": 0
        },
        "proposed_reclaim_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "$ref": "#/$defs/budget_eval"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal_candidate"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proposal_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state",
        "signature",
        "size_bytes",
        "size_basis",
        "size_incomplete"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "prunable",
            "withheld"
          ]
        },
        "signature": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_basis": {
          "type": "string"
        },
        "size_incomplete": {
          "type": "boolean"
        },
        "withheld_reason": {
          "type": "string"
        },
        "last_activity_at": {
          "type": "string",
          "format": "date-time"
        },
        "activity_basis": {
          "type": "string"
        },
        "budget_selected": {
          "type": "boolean"
        },
        "budget_retained": {
          "type": "boolean"
        },
        "dedupe_superseded_by": {
          "type": "string"
        }
      }
    },
    "budget_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_bytes",
        "eviction_order",
        "authority",
        "status",
        "observed_bytes",
        "protected_bytes",
        "eligible_bytes",
        "overage_bytes",
        "selected_bytes",
        "selected_count",
        "retained_bytes",
        "protected_overage_bytes",
        "approval_state"
      ],
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "eviction_order": {
          "enum": [
            "idle-oldest-first"
          ]
        },
        "authority": {
          "const": "propose"
        },
        "status": {
          "enum": [
            "within",
            "exceeded",
            "unknown"
          ]
        },
        "size_basis": {
          "type": "string"
        },
        "observed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "protected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "overage_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "selected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "retained_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "protected_overage_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "approval_state": {
          "enum": [
            "not_needed",
            "approval_required",
            "blocked_by_protection",
            "unknown_observation"
          ]
        }
      }
    },
    "volume_objective_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "floor_bytes",
        "recovery_target_bytes",
        "observation_fresh",
        "observation_complete",
        "outcome",
        "deduplicated_protected_bytes",
        "deduplicated_eligible_bytes",
        "deduplicated_selected_bytes",
        "dropped_overlap_count",
        "floor_shortfall_bytes",
        "recovery_shortfall_bytes",
        "uncovered_shortfall_bytes",
        "approval_request_state"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "volume_id": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "floor_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_target_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "avail_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "diagnostic_level": {
          "enum": [
            "ok",
            "warn",
            "critical"
          ]
        },
        "observation_fresh": {
          "type": "boolean"
        },
        "observation_complete": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "met",
            "evaluable",
            "unmet_protected",
            "unknown"
          ]
        },
        "size_basis": {
          "type": "string"
        },
        "deduplicated_protected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "deduplicated_eligible_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "deduplicated_selected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_overlap_count": {
          "type": "integer",
          "minimum": 0
        },
        "floor_shortfall_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_shortfall_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_shortfall_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "approval_request_state": {
          "enum": [
            "not_needed",
            "approval_required",
            "blocked_by_protection",
            "unknown_observation"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "error"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "error": {
          "enum": [
            "method_not_allowed",
            "invalid_request",
            "unsupported_operation"
          ]
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "record_id",
        "capacity_record_id",
        "captured_at",
        "complete",
        "reasons",
        "rows"
      ],
      "properties": {
        "$schema": {
          "const": "https://schemas.3leaps.dev/spanwit/root-attribution/v0.json"
        },
        "version": {
          "const": 0
        },
        "record_id": {
          "type": "string",
          "format": "uuid"
        },
        "capacity_record_id": {
          "type": "string",
          "format": "uuid"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "initial_baseline",
              "free_space_loss_since_baseline",
              "free_space_loss_since_heartbeat",
              "hourly_baseline",
              "pressure_worsened"
            ]
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation"
            ],
            "properties": {
              "observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "basis",
                  "coverage",
                  "activity",
                  "captured_at",
                  "files",
                  "gaps"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "device_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "const": "path_entry_allocated_blocks_sum"
                  },
                  "coverage": {
                    "enum": [
                      "complete",
                      "partial",
                      "unavailable",
                      "incomparable",
                      "deferred"
                    ]
                  },
                  "activity": {
                    "enum": [
                      "active",
                      "unknown"
                    ]
                  },
                  "captured_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "allocated_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "files": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gaps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "identity": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "coverage": {
                          "const": "complete"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "device_id",
                        "file_id",
                        "allocated_bytes",
                        "identity"
                      ],
                      "properties": {
                        "gaps": {
                          "const": 0
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "required": [
                          "allocated_bytes"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "coverage": {
                          "const": "deferred"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "activity": {
                          "const": "active"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "activity": {
                          "const": "unknown"
                        }
                      }
                    }
                  }
                ]
              },
              "delta_bytes": {
                "type": "integer"
              },
              "baseline_record_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "dependentRequired": {
              "delta_bytes": [
                "baseline_record_id"
              ],
              "baseline_record_id": [
                "delta_bytes"
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "delta_bytes"
                  ]
                },
                "then": {
                  "properties": {
                    "observation": {
                      "properties": {
                        "coverage": {
                          "const": "complete"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "observation": {
                      "properties": {
                        "coverage": {
                          "const": "complete"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "rows": {
                "contains": {
                  "properties": {
                    "observation": {
                      "properties": {
                        "coverage": {
                          "not": {
                            "const": "complete"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
