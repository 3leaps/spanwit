{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/spanwit/daemon-response/v1.json",
  "title": "Experimental observation daemon response",
  "oneOf": [
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/proposals"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "volume_id",
        "basis",
        "avail_bytes",
        "total_bytes",
        "used_bytes",
        "used_percent",
        "level",
        "coverage",
        "seq",
        "size_complete"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "volume_id": {
          "type": "string",
          "minLength": 1
        },
        "mount_path": {
          "type": "string"
        },
        "basis": {
          "const": "statfs_primary"
        },
        "avail_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": [
            "ok",
            "warn",
            "critical"
          ]
        },
        "coverage": {
          "const": "complete"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "const": "capacity.SampleFilesystem"
        },
        "size_complete": {
          "const": true
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "state": {
          "enum": [
            "awaiting_sample",
            "observing",
            "sample_unavailable",
            "journal_unavailable"
          ]
        },
        "sample": {
          "$ref": "#/$defs/sample"
        },
        "record_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "dependentRequired": {
        "sample": [
          "record_id"
        ],
        "record_id": [
          "sample"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observing"
              }
            }
          },
          "then": {
            "required": [
              "sample",
              "record_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "awaiting_sample"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sample"
                  ]
                },
                {
                  "required": [
                    "record_id"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operations",
        "sample_schema",
        "journal_contract",
        "proposal_evaluation",
        "mutation"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "operations": {
          "const": [
            "capabilities",
            "status",
            "proposals.read"
          ]
        },
        "sample_schema": {
          "const": "https://schemas.3leaps.dev/spanwit/growth-sample/v0.json"
        },
        "journal_contract": {
          "const": "durable-record/v1"
        },
        "proposal_evaluation": {
          "const": false
        },
        "mutation": {
          "const": false
        }
      }
    },
    "proposals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state",
        "items",
        "next_cursor"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "state": {
          "const": "not_evaluated"
        },
        "items": {
          "type": "array",
          "maxItems": 0
        },
        "next_cursor": {
          "type": "null"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "error"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "error": {
          "enum": [
            "method_not_allowed",
            "invalid_request",
            "unsupported_operation"
          ]
        }
      }
    }
  }
}
