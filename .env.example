# Spanwit Environment Variables
# Copy this file to .env for local development. All variables are optional.
#
# Env vars use the SPANWIT_ prefix (defined in .fulmen/app.yaml: env_prefix).

# Override the config file path.
# Precedence: --config flag > SPANWIT_CONFIG_PATH > default (~/.config/spanwit/config.yaml)
SPANWIT_CONFIG_PATH=~/.config/spanwit/config.yaml
